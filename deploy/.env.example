# ============================================
# VARIABLES DE ENTORNO - PRODUCCIÓN
# ============================================
# Copiar como: cp deploy/.env.example deploy/.env
# y rellenar los valores reales

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.ejszzazapvskbecycail.supabase.co:5432/postgres?sslmode=require

# JWT (generar con: openssl rand -hex 32)
SECRET_KEY=genera-una-clave-aleatoria-larga-aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
ENVIRONMENT=production
ALLOW_DESTRUCTIVE_MIGRATIONS=false

# Worker de correos de Uber (Gmail IMAP + contraseña de aplicación de 16 caracteres, sin espacios)
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=
# Usuario de la app que recibe los gastos (por defecto GMAIL_USER)
INGEST_USER_EMAIL=tu-correo@gmail.com
EMAIL_POLL_SECONDS=120
# Ventana de búsqueda IMAP en días (solo se procesan correos posteriores al primer arranque)
EMAIL_LOOKBACK_DAYS=7

# Frontend (Nginx interno hace proxy al backend)
VITE_API_URL=/api
